        "community_route_geometry_type_check": {
          "name": "community_route_geometry_type_check",
          "value": "\"community_routes\".\"geometry_type\" IN ('none','original','estimated','reconstructed')"
        },
        "community_route_geometry_validation_check": {
          "name": "community_route_geometry_validation_check",
          "value": "(\"community_routes\".\"geometry_type\" = 'none' AND \"community_routes\".\"geometry_validation\" = 'missing' AND \"community_routes\".\"point_count\" = 0 AND \"community_routes\".\"points_json\" IS NULL) OR (\"community_routes\".\"geometry_type\" != 'none' AND \"community_routes\".\"geometry_validation\" = 'passed' AND \"community_routes\".\"point_count\" BETWEEN 2 AND 2000 AND \"community_routes\".\"points_json\" IS NOT NULL)"
        },
        "community_route_rights_check": {
          "name": "community_route_rights_check",
          "value": "\"community_routes\".\"rights_basis\" IN ('creator','permission','license') AND \"community_routes\".\"permission_confirmed\" = 1 AND \"community_routes\".\"in_game_confirmed\" = 1"
        },
        "community_route_start_check": {
          "name": "community_route_start_check",
          "value": "\"community_routes\".\"start_lat\" BETWEEN -90 AND 90 AND \"community_routes\".\"start_lon\" BETWEEN -180 AND 180"
        },
        "community_route_distance_check": {
          "name": "community_route_distance_check",
          "value": "\"community_routes\".\"reported_distance_m\" BETWEEN 100 AND 100000"
        },
        "community_route_publication_check": {
          "name": "community_route_publication_check",
          "value": "\"community_routes\".\"status\" != 'approved' OR (\"community_routes\".\"rights_reviewed\" = 1 AND \"community_routes\".\"route_reviewed\" = 1 AND \"community_routes\".\"reviewed_at\" IS NOT NULL AND \"community_routes\".\"published_at\" IS NOT NULL AND length(\"community_routes\".\"review_note\") > 0)"
        }
      }
