        },
        "returning_rate_7d_percent": {
          "name": "returning_rate_7d_percent",
          "type": "integer",
          "primaryKey": false,
          "notNull": false,
          "autoincrement": false
        }
      },
      "name": "growth_daily_summary",
      "isExisting": false,
      "definition": "SELECT day, source,\n  SUM(CASE WHEN event = 'page_view' THEN count ELSE 0 END) AS page_views,\n  SUM(CASE WHEN event = 'coordinate_copy' THEN count ELSE 0 END) AS coordinate_copies,\n  SUM(CASE WHEN event = 'share' THEN count ELSE 0 END) AS shares,\n  SUM(CASE WHEN event = 'unique_visitor' THEN count ELSE 0 END) AS unique_visitors,\n  SUM(CASE WHEN event = 'returning_visitor_7d' THEN count ELSE 0 END) AS returning_visitors_7d,\n  CASE WHEN SUM(CASE WHEN event = 'unique_visitor' THEN count ELSE 0 END) = 0 THEN 0.0\n    ELSE ROUND(100.0 * SUM(CASE WHEN event = 'returning_visitor_7d' THEN count ELSE 0 END)\n      / SUM(CASE WHEN event = 'unique_visitor' THEN count ELSE 0 END), 2) END AS returning_rate_7d_percent\n  FROM growth_daily_aggregates GROUP BY day, source"
    }
